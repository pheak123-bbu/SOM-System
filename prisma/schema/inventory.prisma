enum StockMovementType {
  STOCK_IN
  SALE_ORDER
  SALE_POS
  RETURN_RESTOCK
  ADJUSTMENT
  DAMAGE_LOSS
}

model StockMovement {
  id            String            @id @default(cuid())
  storeId       String
  productId     String
  variantId     String?
  type          StockMovementType
  quantity      Int               // Positive for IN/RESTOCK (+5), negative for OUT/SALE (-2)
  previousStock Int?              // Stock before movement
  newStock      Int?              // Stock after movement
  reason        String?           // Reason or notes (e.g., "PO-2026-001", "POS Sale", "Damaged")
  referenceId   String?           // e.g. orderId or orderNumber
  performedBy   String?           // User name or email
  store         Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())

  @@index([storeId, createdAt])
  @@index([productId, createdAt])
  @@index([storeId, type])
}
