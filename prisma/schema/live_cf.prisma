model LiveSession {
  id              String               @id @default(cuid())
  storeId         String
  title           String
  status          String               @default("ACTIVE") // ACTIVE, ENDED, DRAFT
  bannerText      String?              @default("លេខទូរស័ព្ទទំនាក់ទំនង 012 345 678 | ដឹកជញ្ជូន 25 ខេត្ត/ក្រុង")
  topLogoUrl      String?
  activePinId     String?
  publishedLayout String?              @db.Text
  publishedAt     DateTime?
  products        LiveSessionProduct[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  store           Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
}

model LiveSessionProduct {
  id             String          @id @default(cuid())
  sessionId      String
  productId      String
  variantId      String?
  cfCode         String          // e.g. "R445", "A65", "123", "V790"
  customTitle    String?
  customPrice    Decimal         @db.Decimal(12, 2)
  imageUrl       String?
  allocatedStock Int             @default(10)
  remainingStock Int             @default(10)
  position       String          @default("LEFT") // "LEFT" | "RIGHT" | "PINNED" | "HIDDEN" | "CUSTOM"
  posX           Float?
  posY           Float?
  scale          Float           @default(1.0)
  cardSize       String          @default("MEDIUM") // "SMALL" | "MEDIUM" | "LARGE"
  orderIndex     Int             @default(0)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  session        LiveSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([sessionId, cfCode])
  @@index([sessionId, isActive])
}
