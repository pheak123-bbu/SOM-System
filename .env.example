# ========================================================
# SOM - Vercel & Production Environment Configuration
# ========================================================

# 1. DATABASE (Required on Vercel: use Pooled PostgreSQL e.g. Neon or Supabase)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. APPLICATION & AUTHENTICATION SECRETS (Required: generate 32+ characters)
# Example: openssl rand -hex 32
NEXTAUTH_URL=https://your-domain.vercel.app
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
MFA_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
APP_URL=https://your-domain.vercel.app

# 3. AI DETECTION & AUTO-REPLY (Cloud AI recommended for Vercel)
# Providers: "gemini" | "groq" | "openai" | "deepseek" | "pattern"
AI_PROVIDER=gemini
GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# AI_MODEL=gemini-1.5-flash

# 4. TELEGRAM BOT INTEGRATION
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

# 5. DISTRIBUTED RATE LIMITING (Optional for Vercel, e.g. Upstash Redis)
# REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379

# ========================================================
# OPTIONAL / LOCAL DOCKER ONLY (Not needed on Vercel)
# ========================================================
# KEYCLOAK_ISSUER=
# KEYCLOAK_INTERNAL_URL=
# KEYCLOAK_CLIENT_ID=
# KEYCLOAK_CLIENT_SECRET=
# OLLAMA_BASE_URL=http://localhost:11434
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# META_PAGE_ACCESS_TOKEN=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
